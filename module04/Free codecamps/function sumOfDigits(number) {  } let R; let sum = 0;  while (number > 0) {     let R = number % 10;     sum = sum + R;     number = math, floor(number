function twosortedmerge(a1, a2) {
    let r = [];
    let i = 0;
    let j = 0;
    while (i < a1.length && j < a2.length) {
        if (a1[i] < a2[j]) {
            r.push[i];
            i++;
        } else {
            r.push[j];
            j++;
        }
    }
    while (i < a1.length) {
        r.push[j];
        j++;
    }
    while (j < a2.length) {
        r.push[i];
        i++;

    }
    console.log(r);


}
